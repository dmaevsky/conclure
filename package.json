{
  "name": "conclure",
  "version": "2.3.0",
  "description": "Tiny zero-dependency generator runner that brings cancellation and testability to async flows",
  "type": "module",
  "main": "src/conclude.js",
  "module": "src/conclude.js",
  "types": "src/conclude.d.ts",
  "exports": {
    ".": {
      "types": "./src/conclude.d.ts",
      "default": "./src/conclude.js"
    },
    "./effects": {
      "types": "./src/effects.d.ts",
      "default": "./src/effects.js"
    },
    "./combinators": {
      "types": "./src/combinators.d.ts",
      "default": "./src/combinators.js"
    }
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmaevsky/conclure.git"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "generator",
    "runner",
    "saga",
    "yield",
    "promise",
    "async",
    "await",
    "cancellation",
    "effects"
  ],
  "author": "Dmitry Maevsky",
  "license": "MIT"
}
